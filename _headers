# Cloudflare Pages response headers; build.py copies this into _site/.
# GitHub Pages (staging) ignores it.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Every asset URL carries a content hash (?v=), so a changed file gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
